{
  "name": "relay",
  "productName": "Relay",
  "version": "0.1.3",
  "description": "AI coding agents (Claude Code, Codex and any model you connect) working together in one chat",
  "author": "DesyncT",
  "license": "MIT",
  "homepage": "https://github.com/DesyncT/relay",
  "repository": "github:DesyncT/relay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node usage.js",
    "test": "node test-prompt-caching.js && node test-requirement-gate.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.desynct.relay",
    "productName": "Relay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!test-*.js",
      "!skills-lock.json",
      "!.claude/**",
      "!.agents/**",
      "!**/*.md",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/relay.ico"
    },
    "nsis": {
      "artifactName": "Relay-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "DesyncT",
      "repo": "relay"
    }
  }
}
